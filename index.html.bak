  <!-- ====================================================================
       OFFICE LAN SHARING GUIDE MODAL
       ==================================================================== -->
  <div class="modal-overlay" id="modalShare" onclick="if(event.target===this) closeShareModal()">
    <div class="modal-window">
      <div class="modal-header">
        <h3><i class="fa-solid fa-network-wired" style="color:#34d399;"></i> Share with Office Colleagues</h3>
        <button class="modal-close-btn" onclick="closeShareModal()">&times;</button>
      </div>
      <div class="modal-body">
        <p style="font-size:13px; color:var(--text-secondary); line-height:1.5;">
          Your office colleagues on the same Wi-Fi / Local Area Network (LAN) can connect to this exact SQL database in real-time from their browser:
        </p>

        <div style="background:#080d1a; border:1px solid #10b981; border-radius:10px; padding:14px; display:flex; align-items:center; justify-content:space-between;">
          <span style="font-family:'JetBrains Mono', monospace; font-size:14px; font-weight:800; color:#34d399;" id="modalColleagueUrl">
            http://192.168.1.15:8050
          </span>
          <button class="btn-action" onclick="copyColleagueLink()" style="font-size:11px; padding:4px 10px;">
            <i class="fa-regular fa-copy"></i> Copy
          </button>
        </div>

        <div style="font-size:12px; color:var(--text-muted); display:flex; flex-direction:column; gap:6px;">
          <div>✅ <strong>Live Multi-User Sync:</strong> Changes made by colleagues update in SQL instantly.</div>
          <div>✅ <strong>Role Protection:</strong> Admins can create and manage user accounts.</div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-action" onclick="closeShareModal()">Done</button>
      </div>
    </div>
  </div>

  <!-- JAVASCRIPT APPLICATION CONTROLLER -->
  <script>
    let biData = null;
    let allProjects = [];
    let allActions = [];
    let currentUser = { username: "sarah", full_name: "Sarah M.", role: "manager" };

    // Set today's date in form datepickers
    const todayStr = new Date().toISOString().split('T')[0];
    document.getElementById('inpStartDate').value = todayStr;
    document.getElementById('actDueDate').value = todayStr;

    // View Switcher
    function switchView(viewName) {
      document.querySelectorAll('.view-pane').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.nav-tab-btn').forEach(b => b.classList.remove('active'));

      if (viewName === 'dashboard') {
        document.getElementById('viewDashboard').classList.add('active');
        document.getElementById('tabDashboard').classList.add('active');
      } else if (viewName === 'search') {
        document.getElementById('viewSearch').classList.add('active');
        document.getElementById('tabSearch').classList.add('active');
        triggerQuerySearch();
      } else if (viewName === 'tracker') {
        document.getElementById('viewTracker').classList.add('active');
        document.getElementById('tabTracker').classList.add('active');
        renderMasterTable(allProjects);
      } else if (viewName === 'actions') {
        document.getElementById('viewActions').classList.add('active');
        document.getElementById('tabActions').classList.add('active');
        renderKanbanBoard(allActions);
      } else if (viewName === 'vendorBI') {
        document.getElementById('viewVendorBI').classList.add('active');
        document.getElementById('tabVendorBI').classList.add('active');
      }
    }

    // Network Info & IP Discovery
    async function fetchNetworkInfo() {
      try {
        const res = await fetch('/api/network-info');
        const data = await res.json();
        document.getElementById('headerLanIp').textContent = `LAN: ${data.lan_ip}:${data.port}`;
        document.getElementById('modalColleagueUrl').textContent = data.colleague_url;
      } catch (e) {
        console.error('Failed to load network info', e);
      }
    }

    // Load BI Analytics & KPIs
    async function loadBIAnalytics() {
      try {
        const res = await fetch('/api/bi');
        biData = await res.json();
        renderDashboard(biData);
        populateDropdowns(biData.filter_options);
      } catch (e) {
        console.error('Failed to load BI analytics', e);
      }
    }

    function renderDashboard(data) {
      const kpis = data.kpis;
      document.getElementById('dashTotalProjects').textContent = kpis.total_projects;
      document.getElementById('dashInProgress').textContent = kpis.in_progress;
      document.getElementById('dashPending').textContent = kpis.pending_signoff;
      document.getElementById('dashCompleted').textContent = kpis.completed;
      document.getElementById('dashCompletionRate').textContent = `${kpis.completion_rate}%`;
      document.getElementById('dashRateBar').style.width = `${kpis.completion_rate}%`;

      document.getElementById('metricInProgCount').textContent = kpis.in_progress;
      document.getElementById('metricDoneCount').textContent = kpis.completed;
      document.getElementById('metricPendingCount').textContent = kpis.pending_signoff;
      document.getElementById('metricHoldCount').textContent = kpis.on_hold;
      document.getElementById('metricDropCount').textContent = kpis.dropped;

      // Workload List
      const wlContainer = document.getElementById('dashClientWorkloadList');
      wlContainer.innerHTML = data.client_workload.map(c => `
        <div class="workload-item">
          <div class="workload-meta">
            <span>${c.client}</span>
            <span style="color:var(--text-muted); font-size:12px;">${c.count} items (${c.percentage}%)</span>
          </div>
          <div class="workload-bar-wrap">
            <div class="workload-bar-fill" style="width: ${c.percentage}%;"></div>
          </div>
        </div>
      `).join('');

      // Vendor Metrics in View 5
      const vmContainer = document.getElementById('biVendorMetricsList');
      vmContainer.innerHTML = data.vendor_metrics.map(v => `
        <div class="vendor-stat-row">
          <div class="vendor-top-meta">
            <span>${v.vendor}</span>
            <span style="font-family:'JetBrains Mono',monospace; color:var(--text-muted);">${v.projects} Projects</span>
          </div>
          <div style="font-size:11px; color:var(--text-muted); display:flex; justify-content:space-between;">
            <span>Completion Rate: ${v.rate}%</span>
            <span>${v.done} of ${v.projects} Done</span>
          </div>
          <div class="vendor-progress-wrap">
            <div class="vendor-progress-fill" style="width: ${v.rate}%;"></div>
          </div>
        </div>
      `).join('');

      // Client Accounts in View 5
      const caContainer = document.getElementById('biClientAccountsList');
      caContainer.innerHTML = data.client_accounts.map(ca => `
        <div class="client-account-card">
          <div class="client-card-top">
            <span>${ca.client}</span>
            <span class="orders-count-badge">${ca.orders} Active Orders</span>
          </div>
          <div style="font-size:11.5px; color:var(--text-muted);">
            Categories: ${ca.categories.join(', ')}
          </div>
        </div>
      `).join('');
    }

    function populateDropdowns(options) {
      if (!options) return;
      const cSel = document.getElementById('queryClientSelect');
      cSel.innerHTML = '<option value="ALL">All Clients (' + options.clients.length + ')</option>' +
        options.clients.map(c => `<option value="${c}">${c}</option>`).join('');

      const vSel = document.getElementById('queryVendorSelect');
      vSel.innerHTML = '<option value="ALL">All Vendors (' + options.vendors.length + ')</option>' +
        options.vendors.map(v => `<option value="${v}">${v}</option>`).join('');

      const catSel = document.getElementById('queryCategorySelect');
      catSel.innerHTML = '<option value="ALL">All Categories</option>' +
        options.categories.map(cat => `<option value="${cat}">${cat}</option>`).join('');
    }

    // Projects Data & Search
    async function loadProjects() {
      try {
        const res = await fetch('/api/projects');
        allProjects = await res.json();
        const existingIds = new Set(allProjects.map(p => p.id));
        selectedProjectIds.forEach(id => {
          if (!existingIds.has(id)) selectedProjectIds.delete(id);
        });
        document.getElementById('badgeTrackerCount').textContent = allProjects.length;
        lastFilteredProjects = allProjects;
        updateStatusKPIs();
        renderMasterTable(allProjects);
        renderQueryCards(allProjects);
      } catch (e) {
        console.error('Failed to load projects', e);
      }
    }

    function triggerQuerySearch() {
      const q = document.getElementById('querySearchInput').value.toLowerCase().trim();
      const client = document.getElementById('queryClientSelect').value;
      const status = document.getElementById('queryStatusSelect').value;
      const vendor = document.getElementById('queryVendorSelect').value;
      const category = document.getElementById('queryCategorySelect').value;

      const filtered = allProjects.filter(p => {
        const matchQ = !q || p.code.toLowerCase().includes(q) ||
          p.client.toLowerCase().includes(q) ||
          p.description.toLowerCase().includes(q) ||
          p.vendor.toLowerCase().includes(q) ||
          p.owner.toLowerCase().includes(q) ||
          (p.remarks && p.remarks.toLowerCase().includes(q));

        const matchClient = (client === 'ALL' || p.client === client);
        const matchStatus = (status === 'ALL' || p.status === status);
        const matchVendor = (vendor === 'ALL' || p.vendor === vendor);
        const matchCat = (category === 'ALL' || p.category === category);

        return matchQ && matchClient && matchStatus && matchVendor && matchCat;
      });

      document.getElementById('queryFoundCount').textContent = filtered.length;
      renderQueryCards(filtered);
    }

    function renderQueryCards(list) {
      const grid = document.getElementById('queryCardsGrid');
      if (list.length === 0) {
        grid.innerHTML = '<div style="grid-column:1/-1; text-align:center; padding:50px; color:var(--text-muted);">No matching project records found</div>';
        return;
      }

      grid.innerHTML = list.map(p => {
        const pillClass = p.status.replace(/\s+/g, '-');
        return `
          <div class="project-grid-card">
            <div class="project-card-top">
              <span class="project-code-tag">${p.code}</span>
              <span class="client-title">${p.client}</span>
              <span class="status-pill ${pillClass}">${p.status}</span>
            </div>
            <div class="project-title">${p.description}</div>
            <div class="project-meta-row">
              <span><strong>VENDOR:</strong> ${p.vendor}</span>
              <span><strong>OWNER:</strong> ${p.owner}</span>
            </div>
            <div class="project-remarks-box">
              Remarks: ${p.remarks || 'None'}
            </div>
          </div>
        `;
      }).join('');
    }

    let selectedProjectIds = new Set();
    let currentPage = 1;
    const pageSize = 10;
    let totalPages = 1;
    let activeStatusFilter = 'ALL';
    let activeBuyerFilter = 'ALL';
    let lastFilteredProjects = [];

    // Helper: Parse and serialize Remarks Audit Trail
    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function parseRemarksTrail(rawRemarks) {
      if (!rawRemarks) return [];
      const str = String(rawRemarks).trim();
      if (!str) return [];

      const lines = str.split('\n').map(l => l.trim()).filter(Boolean);
      const trail = [];

      for (const line of lines) {
        const m = line.match(/^\[([^\]]+)\]\s*(.*)$/);
        if (m) {
          trail.push({
            text: m[2] || '--',
            timestamp: m[1]
          });
        } else {
          trail.push({
            text: line,
            timestamp: 'Initial Note'
          });
        }
      }

      return trail;
    }

    function serializeRemarksTrail(trail) {
      return trail.map(item => `[${item.timestamp}] ${item.text}`).join('\n');
    }

    // Helper: Timestamp generator with Date, Time, and Second [DD-Mon-YYYY HH:mm:ss]
    function getFullTimestamp() {
      const now = new Date();
      const day = String(now.getDate()).padStart(2, '0');
      const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      const month = months[now.getMonth()];
      const year = now.getFullYear();
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      const s = String(now.getSeconds()).padStart(2, '0');
      return `[${day}-${month}-${year} ${h}:${m}:${s}]`;
    }

    // Update Status Totals KPI Bar
    function updateStatusKPIs() {
      const counts = {
        ALL: allProjects.length,
        'In Progress': 0,
        Completed: 0,
        'On Hold': 0,
        'Pending Approval': 0,
        Dropped: 0
      };

      allProjects.forEach(p => {
        if (counts[p.status] !== undefined) counts[p.status]++;
      });

      const elAll = document.getElementById('countKPI_ALL');
      const elProg = document.getElementById('countKPI_InProgress');
      const elDone = document.getElementById('countKPI_Completed');
      const elHold = document.getElementById('countKPI_OnHold');
      const elPend = document.getElementById('countKPI_Pending');
      const elDrop = document.getElementById('countKPI_Dropped');

      if (elAll) elAll.textContent = counts.ALL;
      if (elProg) elProg.textContent = counts['In Progress'];
      if (elDone) elDone.textContent = counts.Completed;
      if (elHold) elHold.textContent = counts['On Hold'];
      if (elPend) elPend.textContent = counts['Pending Approval'];
      if (elDrop) elDrop.textContent = counts.Dropped;
    }

    function filterByStatusKPI(status) {
      activeStatusFilter = status;
      document.querySelectorAll('.status-kpi-pill').forEach(pill => pill.classList.remove('active'));
      const activePill = document.getElementById(
        status === 'ALL' ? 'kpiStatus_ALL' :
        status === 'In Progress' ? 'kpiStatus_InProgress' :
        status === 'Completed' ? 'kpiStatus_Completed' :
        status === 'On Hold' ? 'kpiStatus_OnHold' :
        status === 'Pending Approval' ? 'kpiStatus_Pending' : 'kpiStatus_Dropped'
      );
      if (activePill) activePill.classList.add('active');
      currentPage = 1;
      applyAllTableFilters();
    }

    function filterByBuyer(buyer, btn) {
      activeBuyerFilter = buyer;
      document.querySelectorAll('.buyer-btn').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
      currentPage = 1;
      applyAllTableFilters();
    }

    function onSearchOrFilterChange() {
      currentPage = 1;
      applyAllTableFilters();
    }

    function applyAllTableFilters() {
      const q = (document.getElementById('tableFilterInput')?.value || '').toLowerCase().trim();

      const filtered = allProjects.filter(p => {
        const matchesQuery = !q || p.code.toLowerCase().includes(q) ||
          p.client.toLowerCase().includes(q) ||
          p.description.toLowerCase().includes(q) ||
          p.vendor.toLowerCase().includes(q) ||
          p.owner.toLowerCase().includes(q) ||
          (p.remarks && p.remarks.toLowerCase().includes(q));

        const matchesStatus = (activeStatusFilter === 'ALL' || p.status === activeStatusFilter);
        const matchesBuyer = (activeBuyerFilter === 'ALL' || p.client.toUpperCase() === activeBuyerFilter.toUpperCase());

        return matchesQuery && matchesStatus && matchesBuyer;
      });

      lastFilteredProjects = filtered;
      renderMasterTable(filtered);
    }

    function renderMasterTable(list) {
      const tbody = document.getElementById('masterTableBody');
      const totalCount = list.length;
      document.getElementById('tableRowsCountText').textContent = `Showing ${totalCount} rows`;

      totalPages = Math.ceil(totalCount / pageSize) || 1;
      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      const startIndex = (currentPage - 1) * pageSize;
      const endIndex = Math.min(startIndex + pageSize, totalCount);
      const pageSlice = list.slice(startIndex, endIndex);

      // Update Pagination Bar UI
      const startEl = document.getElementById('pagRangeStart');
      const endEl = document.getElementById('pagRangeEnd');
      const totalEl = document.getElementById('pagTotalRows');
      const curPageEl = document.getElementById('pagCurrentPageNum');
      const totalPagesEl = document.getElementById('pagTotalPagesNum');

      if (startEl) startEl.textContent = totalCount === 0 ? 0 : startIndex + 1;
      if (endEl) endEl.textContent = endIndex;
      if (totalEl) totalEl.textContent = totalCount;
      if (curPageEl) curPageEl.textContent = currentPage;
      if (totalPagesEl) totalPagesEl.textContent = totalPages;

      const btnFirst = document.getElementById('btnPagFirst');
      const btnPrev = document.getElementById('btnPagPrev');
      const btnNext = document.getElementById('btnPagNext');
      const btnLast = document.getElementById('btnPagLast');

      if (btnFirst) btnFirst.disabled = (currentPage === 1);
      if (btnPrev) btnPrev.disabled = (currentPage === 1);
      if (btnNext) btnNext.disabled = (currentPage === totalPages || totalCount === 0);
      if (btnLast) btnLast.disabled = (currentPage === totalPages || totalCount === 0);

      // Render Page Numbers
      const pagBtnsContainer = document.getElementById('pagNumberButtons');
      if (pagBtnsContainer) {
        let btnsHtml = '';
        for (let i = 1; i <= totalPages; i++) {
          if (totalPages <= 7 || i === 1 || i === totalPages || Math.abs(i - currentPage) <= 1) {
            btnsHtml += `<button class="pag-btn ${i === currentPage ? 'active' : ''}" onclick="goToPage(${i})">${i}</button>`;
          } else if (Math.abs(i - currentPage) === 2) {
            btnsHtml += `<span style="padding:4px 6px; color:#94a3b8;">...</span>`;
          }
        }
        pagBtnsContainer.innerHTML = btnsHtml;
      }

      if (totalCount === 0) {
        tbody.innerHTML = '<tr><td colspan="11" style="text-align:center; padding:35px; color:var(--text-muted); font-size:13px;">No records match the current filter</td></tr>';
        updateBulkActionBar();
        return;
      }

      // Check master checkbox state for current page
      const masterCb = document.getElementById('selectAllCheckbox');
      const allPageSelected = pageSlice.length > 0 && pageSlice.every(p => selectedProjectIds.has(p.id));
      if (masterCb) masterCb.checked = allPageSelected;

      tbody.innerHTML = pageSlice.map(p => {
        const pillClass = p.status.replace(/\s+/g, '-');
        const statusRowClass = `row-status-${p.status.toLowerCase().replace(/\s+/g, '-')}`;
        const isSelected = selectedProjectIds.has(p.id);

        // Parse remarks audit trail
        const trail = parseRemarksTrail(p.remarks);
        let displayHtml = '';
        let fullHoverTooltip = '';

        if (trail.length === 0) {
          displayHtml = '<span style="color:#cbd5e1; font-style:italic;">-- No remarks --</span>';
          fullHoverTooltip = 'No remarks or discussion recorded yet';
        } else {
          const latest = trail[0];
          const olderCount = trail.length - 1;
          const moreBadge = olderCount > 0 
            ? `<span style="background:#e2e8f0; color:#0f172a; font-size:10px; font-weight:700; padding:1px 5px; border-radius:4px; margin-left:6px;">+${olderCount} older</span>` 
            : '';

          displayHtml = `
            <div class="remark-cell-wrapper" onclick="openEditProjectModal(${p.id})">
              <div class="remark-text-line">${escapeHtml(latest.text)}</div>
              <div class="remark-date-subtext">
                <i class="fa-regular fa-clock" style="font-size:10px; margin-right:3px;"></i>${escapeHtml(latest.timestamp)}${moreBadge}
              </div>
            </div>
          `;

          // Format hover tooltip: Remark FIRST, then Date, Time, Second! And shows ALL previous remarks!
          const tooltipParts = [];
          tooltipParts.push(`[LATEST DISCUSSION]\nRemark: ${latest.text}\nDate & Time: ${latest.timestamp}`);

          if (olderCount > 0) {
            tooltipParts.push('\n----------------------------------------\n[PREVIOUS DISCUSSIONS]');
            for (let i = 1; i < trail.length; i++) {
              tooltipParts.push(`${i}. Remark: ${trail[i].text}\n   Date & Time: ${trail[i].timestamp}`);
            }
          }
          fullHoverTooltip = tooltipParts.join('\n').replace(/"/g, '&quot;');
        }

        return `
          <tr id="rowProj_${p.id}" class="${statusRowClass} ${isSelected ? 'row-selected' : ''}">
            <td style="text-align:center;">
              <input type="checkbox" class="row-select-checkbox" data-id="${p.id}" ${isSelected ? 'checked' : ''} onchange="onRowCheckboxChange(this, ${p.id})" style="cursor:pointer; width:15px; height:15px; accent-color:#0f172a;">
            </td>
            <td>
              <div class="code-badge-interactive" id="codeCell_${p.id}" onclick="startEditCode(${p.id}, '${p.code}')" title="Click to edit code">
                <span>${p.code}</span>
                <i class="fa-solid fa-pen code-pen-icon"></i>
              </div>
            </td>
            <td style="font-weight:800; color:#0f172a;">${p.client}</td>
            <td style="font-family:'JetBrains Mono',monospace; color:#64748b; font-size:12px;">${p.start_date}</td>
            <td class="td-task-desc" style="font-weight:600;">${p.description}</td>
            <td><span class="category-tag">${p.category}</span></td>
            <td style="color:#475569;">${p.vendor}</td>
            <td style="color:#475569; font-weight:600;">${p.owner}</td>
            <td>
              <select class="status-quick-select status-pill ${pillClass}" onchange="quickUpdateProjectStatus(${p.id}, this.value, '${p.code}')" title="Change status directly">
                <option value="In Progress" ${p.status === 'In Progress' ? 'selected' : ''}>In Progress</option>
                <option value="Completed" ${p.status === 'Completed' ? 'selected' : ''}>Completed</option>
                <option value="On Hold" ${p.status === 'On Hold' ? 'selected' : ''}>On Hold</option>
                <option value="Pending Approval" ${p.status === 'Pending Approval' ? 'selected' : ''}>Pending Approval</option>
                <option value="Dropped" ${p.status === 'Dropped' ? 'selected' : ''}>Dropped</option>
              </select>
            </td>
            <td title="${fullHoverTooltip}">
              ${displayHtml}
            </td>
            <td style="text-align:center; white-space:nowrap;">
              <button class="btn-table-action" onclick="openEditProjectModal(${p.id})" title="Edit Project & Code" style="color:#0f172a; margin-right:10px; font-size:15px; cursor:pointer;">
                <i class="fa-solid fa-pen-to-square"></i>
              </button>
              <button class="btn-table-action" onclick="deleteProjectRecord(${p.id}, '${p.code}')" title="Delete" style="color:#ef4444; font-size:15px; cursor:pointer;">
                <i class="fa-solid fa-trash"></i>
              </button>
            </td>
          </tr>
        `;
      }).join('');

      updateBulkActionBar();
    }

    function goToPage(page) {
      if (page < 1 || page > totalPages) return;
      currentPage = page;
      renderMasterTable(lastFilteredProjects);
    }

    async function quickUpdateProjectStatus(id, newStatus, code) {
      try {
        const res = await fetch(`/api/projects/${id}/status`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: newStatus })
        });
        const data = await res.json();
        if (!res.ok) {
          alert(data.detail || 'Could not update status');
          return;
        }

        // Update local memory
        const proj = allProjects.find(x => x.id === id);
        if (proj) proj.status = newStatus;

        showToast(`Status of [${code}] updated to [${newStatus}]`);
        updateStatusKPIs();
        renderMasterTable(lastFilteredProjects);
        await loadBIAnalytics();
      } catch (err) {
        alert(err.message);
      }
    }

    function onRowCheckboxChange(cb, id) {
      if (cb.checked) {
        selectedProjectIds.add(id);
      } else {
        selectedProjectIds.delete(id);
      }
      const row = document.getElementById(`rowProj_${id}`);
      if (row) {
        if (cb.checked) row.classList.add('row-selected');
        else row.classList.remove('row-selected');
      }
      updateMasterCheckboxState();
      updateBulkActionBar();
    }

    function toggleSelectAll(masterCb) {
      const q = document.getElementById('tableFilterInput').value.toLowerCase().trim();
      const currentList = allProjects.filter(p => {
        return !q || p.code.toLowerCase().includes(q) ||
          p.client.toLowerCase().includes(q) ||
          p.description.toLowerCase().includes(q) ||
          p.vendor.toLowerCase().includes(q) ||
          p.owner.toLowerCase().includes(q) ||
          (p.remarks && p.remarks.toLowerCase().includes(q));
      });

      if (masterCb.checked) {
        currentList.forEach(p => selectedProjectIds.add(p.id));
      } else {
        currentList.forEach(p => selectedProjectIds.delete(p.id));
      }

      renderMasterTable(currentList);
    }

    function updateMasterCheckboxState() {
      const masterCb = document.getElementById('selectAllCheckbox');
      if (!masterCb) return;
      const checkboxes = document.querySelectorAll('.row-select-checkbox');
      if (checkboxes.length === 0) {
        masterCb.checked = false;
        masterCb.indeterminate = false;
        return;
      }
      const checkedCount = document.querySelectorAll('.row-select-checkbox:checked').length;
      masterCb.checked = checkedCount === checkboxes.length;
      masterCb.indeterminate = checkedCount > 0 && checkedCount < checkboxes.length;
    }

    function updateBulkActionBar() {
      const bar = document.getElementById('bulkActionBar');
      const countEl = document.getElementById('bulkSelectedCount');
      if (!bar) return;
      const count = selectedProjectIds.size;
      if (count > 0) {
        bar.style.display = 'flex';
        if (countEl) countEl.textContent = `${count} selected`;
      } else {
        bar.style.display = 'none';
      }
    }

    function clearAllSelections() {
      selectedProjectIds.clear();
      const masterCb = document.getElementById('selectAllCheckbox');
      if (masterCb) {
        masterCb.checked = false;
        masterCb.indeterminate = false;
      }
      document.querySelectorAll('.row-select-checkbox').forEach(cb => cb.checked = false);
      document.querySelectorAll('tr.row-selected').forEach(tr => tr.classList.remove('row-selected'));
      updateBulkActionBar();
    }

    async function bulkDeleteSelected() {
      const count = selectedProjectIds.size;
      if (count === 0) return;
      if (!confirm(`Are you sure you want to permanently delete ${count} selected project(s)?`)) return;

      try {
        const res = await fetch('/api/projects/bulk-delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids: Array.from(selectedProjectIds) })
        });
        const data = await res.json();
        if (!res.ok) {
          alert(data.detail || 'Failed to delete selected projects');
          return;
        }

        showToast(`🗑️ Successfully deleted ${data.count || count} projects`);
        selectedProjectIds.clear();
        await loadProjects();
        await loadBIAnalytics();
      } catch (err) {
        alert(err.message);
      }
    }

    function filterMasterTable() {
      const q = document.getElementById('tableFilterInput').value.toLowerCase().trim();
      const filtered = allProjects.filter(p => {
        return !q || p.code.toLowerCase().includes(q) ||
          p.client.toLowerCase().includes(q) ||
          p.description.toLowerCase().includes(q) ||
          p.vendor.toLowerCase().includes(q) ||
          p.owner.toLowerCase().includes(q) ||
          (p.remarks && p.remarks.toLowerCase().includes(q));
      });
      renderMasterTable(filtered);
    }

    // Daily Actions (Kanban)
    async function loadActions() {
      try {
        const res = await fetch('/api/actions');
        allActions = await res.json();
        document.getElementById('badgeActionsCount').textContent = allActions.length;
        renderKanbanBoard(allActions);
        renderImmediateActionsDashboard(allActions);
      } catch (e) {
        console.error('Failed to load actions', e);
      }
    }

    function renderKanbanBoard(list) {
      const lanes = {
        'Action Required': { stack: document.getElementById('stackLaneAction'), count: document.getElementById('countLaneAction') },
        'In Progress': { stack: document.getElementById('stackLaneInProgress'), count: document.getElementById('countLaneInProgress') },
        'Pending Approval': { stack: document.getElementById('stackLanePending'), count: document.getElementById('countLanePending') },
        'Completed': { stack: document.getElementById('stackLaneCompleted'), count: document.getElementById('countLaneCompleted') }
      };

      Object.values(lanes).forEach(l => {
        l.stack.innerHTML = '';
        l.count.textContent = '0';
      });

      const counts = { 'Action Required': 0, 'In Progress': 0, 'Pending Approval': 0, 'Completed': 0 };

      list.forEach(item => {
        const laneKey = item.lane in lanes ? item.lane : 'Action Required';
        counts[laneKey]++;

        const card = document.createElement('div');
        card.className = 'kanban-card';
        card.innerHTML = `
          <div style="display:flex; align-items:center; justify-content:space-between;">
            <span class="client-badge-pill">${item.client}</span>
            <span class="priority-badge priority-${item.priority}">${item.priority}</span>
          </div>
          <div style="font-size:13.5px; font-weight:700; color:var(--text-main);">${item.task_title}</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--text-muted); display:flex; align-items:center; gap:6px;">
            <i class="fa-regular fa-calendar"></i> ${item.due_date || 'No Date'}
          </div>
          <div class="kanban-move-bar">
            <span>Move:</span>
            ${laneKey !== 'Action Required' ? `<button class="btn-move" onclick="moveActionLane(${item.id}, 'Action Required')">Act</button>` : ''}
            ${laneKey !== 'In Progress' ? `<button class="btn-move" onclick="moveActionLane(${item.id}, 'In Progress')">In</button>` : ''}
            ${laneKey !== 'Pending Approval' ? `<button class="btn-move" onclick="moveActionLane(${item.id}, 'Pending Approval')">Pen</button>` : ''}
            ${laneKey !== 'Completed' ? `<button class="btn-move" onclick="moveActionLane(${item.id}, 'Completed')">Com</button>` : ''}
            <button class="btn-table-action" onclick="deleteActionTask(${item.id})" style="margin-left:auto;"><i class="fa-solid fa-xmark"></i></button>
          </div>
        `;
        lanes[laneKey].stack.appendChild(card);
      });

      Object.keys(lanes).forEach(k => {
        lanes[k].count.textContent = counts[k];
      });
    }

    function renderImmediateActionsDashboard(list) {
      const urgent = list.slice(0, 3);
      const container = document.getElementById('dashImmediateActionsList');
      container.innerHTML = urgent.map(item => `
        <div class="action-card-preview">
          <div class="action-top-row">
            <span class="client-badge-pill">${item.client}</span>
            <span class="action-date"><i class="fa-regular fa-calendar"></i> ${item.due_date}</span>
          </div>
          <div class="action-desc">${item.task_title}</div>
          <div class="action-status-tag">Status: <strong>${item.lane}</strong></div>
        </div>
      `).join('');
    }

    async function moveActionLane(id, lane) {
      try {
        await fetch(`/api/actions/${id}/lane`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ lane: lane })
        });
        await loadActions();
      } catch (e) {
        console.error(e);
      }
    }

    async function deleteActionTask(id) {
      if (!confirm('Delete this action item?')) return;
      try {
        await fetch(`/api/actions/${id}`, { method: 'DELETE' });
        await loadActions();
      } catch (e) {
        console.error(e);
      }
    }

    
    // --- Inline Code & Project Edit Handlers ---
    function startEditCode(id, currentCode) {
      const cell = document.getElementById(`codeCell_${id}`);
      if (!cell) return;
      cell.outerHTML = `
        <div class="inline-code-edit-wrap" id="codeWrap_${id}">
          <input type="text" class="inline-code-input" id="inlineCodeInput_${id}" value="${currentCode}" 
            onkeydown="if(event.key==='Enter') saveInlineCode(${id}); if(event.key==='Escape') cancelInlineCode(${id}, '${currentCode}');"
          />
          <button class="btn-code-save" onclick="saveInlineCode(${id})" title="Save Code"><i class="fa-solid fa-check"></i></button>
          <button class="btn-code-cancel" onclick="cancelInlineCode(${id}, '${currentCode}')" title="Cancel"><i class="fa-solid fa-xmark"></i></button>
        </div>
      `;
      const inp = document.getElementById(`inlineCodeInput_${id}`);
      if (inp) {
        inp.focus();
        inp.select();
      }
    }

    function cancelInlineCode(id, originalCode) {
      const wrap = document.getElementById(`codeWrap_${id}`);
      if (!wrap) return;
      wrap.outerHTML = `
        <div class="code-badge-interactive" id="codeCell_${id}" onclick="startEditCode(${id}, '${originalCode}')" title="Click to edit code">
          <span>${originalCode}</span>
          <i class="fa-solid fa-pen code-pen-icon"></i>
        </div>
      `;
    }

    async function saveInlineCode(id) {
      const inp = document.getElementById(`inlineCodeInput_${id}`);
      if (!inp) return;
      const newCode = inp.value.trim().toUpperCase();
      if (!newCode) {
        alert("Project code cannot be empty");
        inp.focus();
        return;
      }

      try {
        const res = await fetch(`/api/projects/${id}/code`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code: newCode })
        });
        const data = await res.json();
        if (!res.ok) {
          alert(data.detail || 'Could not update project code');
          inp.focus();
          return;
        }

        showToast(`✅ Project code updated to [${data.code}] in SQL`);
        await loadProjects();
        await loadBIAnalytics();
      } catch (err) {
        alert(err.message);
      }
    }

    function openEditProjectModal(id) {
      const p = allProjects.find(x => x.id === id);
      if (!p) return;
      document.getElementById('editProjId').value = p.id;
      document.getElementById('editProjCode').value = p.code;
      document.getElementById('editProjClient').value = p.client;
      document.getElementById('editProjStartDate').value = p.start_date;
      document.getElementById('editProjStatus').value = p.status;
      document.getElementById('editProjDesc').value = p.description;
      document.getElementById('editProjVendor').value = p.vendor;
      document.getElementById('editProjOwner').value = p.owner;
      document.getElementById('editProjCategory').value = p.category;

      // Remarks Trail Handling
      const trail = parseRemarksTrail(p.remarks);
      const trailContainer = document.getElementById('editProjRemarksHistory');
      const countEl = document.getElementById('editRemarksCountText');
      if (countEl) countEl.textContent = `${trail.length} ${trail.length === 1 ? 'entry' : 'entries'}`;

      if (trailContainer) {
        if (trail.length === 0) {
          trailContainer.innerHTML = '<span style="color:#94a3b8; font-style:italic;">No previous discussions or notes recorded yet.</span>';
        } else {
          trailContainer.innerHTML = trail.map((item, idx) => `
            <div style="background:#ffffff; border:1px solid #e2e8f0; border-radius:6px; padding:7px 10px;">
              <div style="font-weight:700; color:#1e293b; margin-bottom:2px;">Remark: ${escapeHtml(item.text)}</div>
              <div style="font-size:11px; color:#475569; font-family:'JetBrains Mono',monospace; font-weight:600;">
                <i class="fa-regular fa-clock" style="margin-right:3px;"></i>Date & Time: ${escapeHtml(item.timestamp)}
              </div>
            </div>
          `).join('');
        }
      }

      // New remark input box is ALWAYS EMPTY for the next update!
      const newRemarkInput = document.getElementById('editProjNewRemark');
      if (newRemarkInput) {
        newRemarkInput.value = '';
        setTimeout(() => newRemarkInput.focus(), 150);
      }

      document.getElementById('modalEditProject').classList.add('open');
    }

    function closeEditProjectModal() {
      document.getElementById('modalEditProject').classList.remove('open');
    }

    async function submitEditProject() {
      const id = document.getElementById('editProjId').value;
      const p = allProjects.find(x => String(x.id) === String(id));
      const existingTrail = parseRemarksTrail(p ? p.remarks : '');

      const newRemarkText = (document.getElementById('editProjNewRemark')?.value || '').trim();
      let updatedTrail = [...existingTrail];

      if (newRemarkText) {
        // Prepend new remark to the top of the history with current live date, time, and second!
        const cleanTimestamp = getFullTimestamp().replace(/^\[|\]$/g, '');
        updatedTrail.unshift({
          text: newRemarkText,
          timestamp: cleanTimestamp
        });
      }

      const serializedRemarks = serializeRemarksTrail(updatedTrail);

      const data = {
        code: document.getElementById('editProjCode').value.trim().toUpperCase(),
        client: document.getElementById('editProjClient').value.trim(),
        start_date: document.getElementById('editProjStartDate').value,
        status: document.getElementById('editProjStatus').value,
        description: document.getElementById('editProjDesc').value.trim(),
        vendor: document.getElementById('editProjVendor').value.trim(),
        owner: document.getElementById('editProjOwner').value.trim(),
        category: document.getElementById('editProjCategory').value.trim(),
        remarks: serializedRemarks
      };

      if (!data.code || !data.client || !data.description) {
        alert('Please fill in Project Code, Client Account, and Task Description');
        return;
      }

      try {
        const res = await fetch(`/api/projects/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const resData = await res.json();
        if (!res.ok) {
          alert(resData.detail || 'Could not update project');
          return;
        }

        closeEditProjectModal();
        showToast(`✅ Project record [${data.code}] updated successfully`);
        await loadProjects();
        await loadBIAnalytics();
      } catch (err) {
        alert(err.message);
      }
    }

    function showToast(msg) {
      const existing = document.getElementById('appToast');
      if (existing) existing.remove();
      const toast = document.createElement('div');
      toast.id = 'appToast';
      toast.className = 'toast-notification';
      toast.innerHTML = `<i class="fa-solid fa-circle-check" style="color:#10b981;"></i> <span>${msg}</span>`;
      document.body.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transition = 'opacity 0.3s ease';
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    // Modal Handlers
    function openCreateProjectModal() {
      const nextNum = allProjects.length + 1;
      const autoCode = `PRJ-${String(nextNum).padStart(3, "0")}`;
      const inpCode = document.getElementById('inpCode');
      if (inpCode) inpCode.value = autoCode;
      document.getElementById('modalCreateProject').classList.add('open');
    }
    function closeCreateProjectModal() {
      document.getElementById('modalCreateProject').classList.remove('open');
    }

    async function submitCreateProject() {
      const inpCode = document.getElementById('inpCode');
      const rawRemark = document.getElementById('inpRemarks').value.trim();
      const stampedRemark = rawRemark ? `${getFullTimestamp()} ${rawRemark}` : '';

      const data = {
        code: inpCode ? inpCode.value.trim().toUpperCase() : undefined,
        client: document.getElementById('inpClient').value.trim(),
        start_date: document.getElementById('inpStartDate').value,
        description: document.getElementById('inpDesc').value.trim(),
        vendor: document.getElementById('inpVendor').value.trim(),
        owner: document.getElementById('inpOwner').value.trim(),
        category: document.getElementById('inpCategory').value.trim(),
        status: document.getElementById('inpStatus').value,
        remarks: stampedRemark
      };

      if (!data.client || !data.description) {
        alert('Please fill in Client Account and Task Description');
        return;
      }

      try {
        await fetch('/api/projects', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        closeCreateProjectModal();
        await loadProjects();
        await loadBIAnalytics();
      } catch (e) {
        console.error(e);
      }
    }

    async function deleteProjectRecord(id, code) {
      const p = allProjects.find(x => x.id === id);
      const label = code || (p ? p.code : `#${id}`);
      if (!confirm(`Are you sure you want to permanently delete project [${label}]?`)) return;
      try {
        const res = await fetch(`/api/projects/${id}`, { method: 'DELETE' });
        if (!res.ok) {
          alert('Could not delete project');
          return;
        }
        selectedProjectIds.delete(id);
        showToast(`🗑️ Project [${label}] deleted`);
        await loadProjects();
        await loadBIAnalytics();
      } catch (e) {
        console.error(e);
        alert(e.message);
      }
    }

    function openCreateActionModal() {
      document.getElementById('modalCreateAction').classList.add('open');
    }
    function closeCreateActionModal() {
      document.getElementById('modalCreateAction').classList.remove('open');
    }

    async function submitCreateAction() {
      const data = {
        client: document.getElementById('actClient').value.trim(),
        priority: document.getElementById('actPriority').value,
        task_title: document.getElementById('actTitle').value.trim(),
        lane: document.getElementById('actLane').value,
        due_date: document.getElementById('actDueDate').value
      };

      if (!data.client || !data.task_title) {
        alert('Please fill in Client and Task Title');
        return;
      }

      try {
        await fetch('/api/actions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        closeCreateActionModal();
        await loadActions();
      } catch (e) {
        console.error(e);
      }
    }

    function openShareModal() {
      document.getElementById('modalShare').classList.add('open');
    }
    function closeShareModal() {
      document.getElementById('modalShare').classList.remove('open');
    }

    function copyColleagueLink() {
      const url = document.getElementById('modalColleagueUrl').textContent.trim();
      navigator.clipboard.writeText(url);
      alert('Office Connection URL copied to clipboard!\nShare this with colleagues: ' + url);
    }

    function openUserModal() {
      const modal = document.getElementById('modalUserProfile');
      if (modal) modal.classList.add('open');
    }
    function closeUserModal() {
      const modal = document.getElementById('modalUserProfile');
      if (modal) modal.classList.remove('open');
    }

    async function checkAuthStatus() {
      try {
        const res = await fetch('/api/auth/me');
        const data = await res.json();
        if (data.authenticated && data.user) {
          document.getElementById('headerUserName').textContent = data.user.full_name;
          document.getElementById('headerUserAvatar').textContent = data.user.full_name.charAt(0);
          if (data.user.role === 'admin') {
            const btn = document.getElementById('btnAdminPanelNav');
            if (btn) btn.style.display = 'inline-flex';
          }
        }
      } catch (e) {
        console.log('Guest state');
      }
    }

    async function logoutPortal() {
      await fetch('/api/auth/logout', { method: 'POST' });
      localStorage.removeItem('ma_maison_token');
      localStorage.removeItem('ma_maison_user');
      window.location.href = '/';
    }

    // Initialize Data
    checkAuthStatus();
    fetchNetworkInfo();
    loadBIAnalytics();
    loadProjects();
    loadActions();
  </script>
</body>
</html>

