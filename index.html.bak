  <!-- ====================================================================
       EDIT PROJECT MODAL
       ==================================================================== -->
  <div class="modal-overlay" id="modalEditProject" onclick="if(event.target===this) closeEditProjectModal()">
    <div class="modal-window">
      <div class="modal-header">
        <h3><i class="fa-solid fa-pen-to-square" style="color:var(--accent-purple);"></i> Edit Project & Code</h3>
        <button class="modal-close-btn" onclick="closeEditProjectModal()">&times;</button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="editProjId">
        <div class="form-row-2col">
          <div class="form-group">
            <label>Project Code (Editable / Custom)</label>
            <input type="text" class="form-input" id="editProjCode" placeholder="e.g. PRJ-001" style="text-transform:uppercase; font-family:'JetBrains Mono',monospace; font-weight:800; color:#0f172a; background:#f8fafc;">
          </div>
          <div class="form-group">
            <label>Client Account</label>
            <input type="text" class="form-input" id="editProjClient" placeholder="e.g. JACENT">
          </div>
        </div>

        <div class="form-row-2col">
          <div class="form-group">
            <label>Start Date</label>
            <input type="date" class="form-input" id="editProjStartDate">
          </div>
          <div class="form-group">
            <label>Category</label>
            <input type="text" class="form-input" id="editProjCategory" placeholder="e.g. Product Dev">
          </div>
        </div>

        <div class="form-group">
          <label>Task / Product Description</label>
          <textarea class="form-textarea" id="editProjDesc" placeholder="Enter detailed task summary..."></textarea>
        </div>

        <div class="form-row-2col">
          <div class="form-group">
            <label>Vendor / Mill</label>
            <input type="text" class="form-input" id="editProjVendor" placeholder="e.g. Shaoxing Textile Co.">
          </div>
          <div class="form-group">
            <label>Owner / Manager</label>
            <input type="text" class="form-input" id="editProjOwner" placeholder="e.g. Sarah M.">
          </div>
        </div>

        <div class="form-group">
          <label>Status</label>
          <select class="form-select" id="editProjStatus">
            <option value="In Progress">In Progress</option>
            <option value="Completed">Completed</option>
            <option value="Pending Approval">Pending Approval</option>
            <option value="On Hold">On Hold</option>
            <option value="Dropped">Dropped</option>
          </select>
        </div>

        <!-- REMARKS AUDIT TRAIL / LAST DISCUSSION -->
        <div class="form-group">
          <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:6px;">
            <label style="font-weight:700; color:#1e293b; margin-bottom:0;">
              <i class="fa-solid fa-clock-rotate-left" style="color:#0f172a;"></i> Last Discussion & Remarks History
            </label>
            <span style="font-size:11px; font-weight:700; color:#0f172a; background:#e2e8f0; padding:2px 8px; border-radius:10px;" id="editRemarksCountText">0 entries</span>
          </div>
          <div id="editProjRemarksHistory" style="max-height:140px; overflow-y:auto; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:10px 12px; font-size:12px; display:flex; flex-direction:column; gap:8px;">
            <!-- Rendered dynamically -->
          </div>
        </div>

        <!-- NEW REMARK INPUT (ALWAYS EMPTY FOR NEXT UPDATE) -->
        <div class="form-group" style="margin-top:10px;">
          <label style="color:#0f172a; font-weight:800; display:flex; align-items:center; gap:6px;">
            <i class="fa-solid fa-plus-circle" style="color:#0f172a;"></i> Add New Update / Next Discussion Note:
          </label>
          <textarea class="form-textarea" id="editProjNewRemark" placeholder="Type new update / discussion notes here (will be auto-saved with today's date, time and seconds)..." style="height:65px; border-color:#cbd5e1; background:#ffffff; font-size:12.5px;"></textarea>
          <span style="font-size:11px; color:#64748b; margin-top:3px; display:block;">Remark box is empty for your new update. Leave empty if no changes.</span>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-action" onclick="closeEditProjectModal()">Cancel</button>
        <button class="btn-action btn-primary-purple" onclick="submitEditProject()">Save Changes</button>
      </div>
    </div>
  </div>


  <!-- ====================================================================
